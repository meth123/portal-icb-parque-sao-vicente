# Valores públicos encontrados no painel do projeto Supabase.
# Copie este arquivo para .env.local e substitua os exemplos localmente.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_este_valor

# Chave secreta usada somente por operações administrativas no servidor.
# Nunca use prefixo NEXT_PUBLIC_ e nunca envie o valor real ao GitHub.
SUPABASE_SECRET_KEY=sb_secret_substitua_este_valor
