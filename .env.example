# Valores públicos encontrados no painel do projeto Supabase.
# Copie este arquivo para .env.local e substitua os exemplos localmente.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_este_valor

# Chave secreta usada somente por operações administrativas no servidor.
# Nunca use prefixo NEXT_PUBLIC_ e nunca envie o valor real ao GitHub.
SUPABASE_SECRET_KEY=sb_secret_substitua_este_valor

# Web Push. Gere o par VAPID uma vez e mantenha a chave privada somente no servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=substitua_pela_chave_publica_vapid
VAPID_PRIVATE_KEY=substitua_pela_chave_privada_vapid
VAPID_SUBJECT=mailto:icbconecta@gmail.com

# A Vercel envia este valor como Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=substitua_por_um_segredo_aleatorio_com_pelo_menos_16_caracteres

# Opcional e somente para banco/ambiente de teste. Nunca habilite em Production.
PUSH_TEST_MODE=false
